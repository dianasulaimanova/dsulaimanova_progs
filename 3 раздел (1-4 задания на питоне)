import math

def compute_product(initial, term, precision, max_iter=1000000):
    product = initial
    prev = 0
    n = 1
    
    while abs(product - prev) > precision and n <= max_iter:
        prev = product
        product *= term(n)
        n += 1
    
    return product

def term1(n):
    return 1.0 - 1.0/(n*n)

def term2(x):
    return 1.0 + (1.0/3.0)**3*x

def term3(n):
    return (3.0*n + 1.0)/(2.0*n - 1.0)

def term4(n):
    return 1.0 + 2.0/(3.0*n + n*n)

def check_divergence(term, check_iter=10000):
    log_sum = 0.0
    for i in range(1, check_iter+1):
        log_sum += math.log(term(i))
        if log_sum > 100:
            return True
    return False

precision = 1e-6

# Product 1
p1 = compute_product(1.0, term1, precision, 2)
print(f"1) ∏(1-1/n²) ≈ {p1} (theoretical: 0.5)\n")

# Product 2
p2 = compute_product(1.0, term2, precision, 0)
print(f"2) ∏(1+(1/3)^(3x)) ≈ {p2}\n")

# Product 3
if check_divergence(term3):
    print("3) ∏((3n+1)/(2n-1)) diverges")
    print("   Demonstration of growth:")
    p3 = 1.0
    for n in range(1, 11):
        p3 *= term3(n)
        print(f"   n={n}: {p3}")
else:
    p3 = compute_product(1.0, term3, precision)
    print(f"3) ∏((3n+1)/(2n-1)) ≈ {p3}\n")

# Product 4
p4 = compute_product(1.0, term4, precision)
print(f"4) ∏(1+2/(3n+n²)) ≈ {p4}")
