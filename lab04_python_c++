#include <cmath>
#include <iomanip>

using namespace std;

const double g = 9.81; // Ускорение свободного падения

// Функция для вычисления времени полета T методом итерации
double compute_flight_time(double V, double a, double H, double epsilon = 1e-6, int max_iter = 100) {
    double T = (V * sin(a) + sqrt(pow(V * sin(a), 2) + 2 * g * H)) / g; // Начальное приближение
    double T_new;
    
    for (int i = 0; i < max_iter; ++i) {
        T_new = (V * sin(a) + sqrt(pow(V * sin(a), 2) + 2 * g * H - 2 * g * (H + V * T * sin(a) - g * pow(T, 2) / 2))) / g;
        
        if (abs(T_new - T) < epsilon) {
            return T_new;
        }
        
        T = T_new;
    }
    
    throw runtime_error("Метод итерации не сошелся за указанное число итераций");
}

int main() {
    try {
        double H, V, a_deg, t;
        
        // Ввод данных
        cout << "Введите высоту обрыва H (м): ";
        cin >> H;
        cout << "Введите начальную скорость V (м/с): ";
        cin >> V;
        cout << "Введите угол броска a (градусы): ";
        cin >> a_deg;
        cout << "Введите время t (с): ";
        cin >> t;
        
        // Преобразование угла в радианы
        double a = a_deg * M_PI / 180.0;
        
        // Вычисление времени полета
        double T = compute_flight_time(V, a, H);
        
        // Вычисление координат в момент времени t
        double x = V * t * cos(a);
        double y = (t <= T) ? (H + V * t * sin(a) - 0.5 * g * pow(t, 2)) : 0.0;
        
        // Вывод результатов
        cout << fixed << setprecision(2);
        cout << "\nРезультаты расчета:\n";
        cout << "Время полета T (с): " << T << endl;
        cout << "Расстояние от края обрыва x(t) (м): " << x << endl;
        cout << "Высота от дна обрыва y(t) (м): " << y << endl;
        cout << "Состояние: " << ((t <= T) ? "Камень в полете" : "Камень упал на дно") << endl;
        
    } catch (const exception& e) {
        cerr << "Ошибка: " << e.what() << endl;
        return 1;
    }
    
    return 0;
}
