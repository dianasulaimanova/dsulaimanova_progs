import math

def calculate_release_distance(height, speed):
    """
    Вычисляет подлётное расстояние S для сброса бомбы.
    
    Параметры:
        height (float): Высота полёта H (в метрах)
        speed (float): Скорость самолёта U (в м/с)
    
    Возвращает:
        float: Расстояние S до цели (в метрах)
    """
    g = 9.81  # Ускорение свободного падения (м/с²)
    fall_time = math.sqrt(2 * height / g)  # Время падения бомбы T
    release_distance = speed * fall_time  # Расстояние S = U*T
    return release_distance

