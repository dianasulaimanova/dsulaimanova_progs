#include <iostream>
#include <cmath>
using namespace std;

double calculateReleaseDistance(double height, double speed) {
    /**
     * Вычисляет подлётное расстояние S для сброса бомбы.
     * 
     * Параметры:
     *     height: Высота полёта H (в метрах)
     *     speed: Скорость самолёта U (в м/с)
     * 
     * Возвращает:
     *     Расстояние S до цели (в метрах)
     */
    const double g = 9.81;  // Ускорение свободного падения (м/с²)
    double fall_time = sqrt(2 * height / g);  // Время падения бомбы T
    double release_distance = speed * fall_time;  // Расстояние S = U*T
    return release_distance;
}

int main() {
    double H, U;
    
    // Ввод данных
    cout << "Введите высоту полёта H (м): ";
    cin >> H;
    cout << "Введите скорость самолёта U (м/с): ";
    cin >> U;
    
    // Вычисление и вывод результата
    double S = calculateReleaseDistance(H, U);
    cout << "Подлётное расстояние для сброса бомбы: " << S << " м" << endl;
    
    return 0;
