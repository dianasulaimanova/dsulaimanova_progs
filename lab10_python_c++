10 #include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

int main() {
    const double G = 6.672e-11, M = 5.96e24, R = 6.37e6;
    double h;
    
    cout << "Введите высоту (м): ";
    cin >> h;
    
    double g = G * M / pow(R + h, 2);
    cout << fixed << setprecision(2);
    cout << "g = " << g << " м/с²\n";
    
    // Таблица значений
    cout << "\nВысота(км)\tg(м/с²)\n";
    for(int km = 0; km <= 1000; km += 100) {
        double h = km * 1000;
        cout << km << "\t\t" << G*M/pow(R+h,2) << "\n";
    }
    
    return 0;
}
