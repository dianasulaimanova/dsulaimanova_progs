#include <cmath>
#include <iomanip>
#include <stdexcept>

using namespace std;

const double g = 9.81; // Ускорение свободного падения (м/с²)

// Функция для вычисления времени падения бомбы
double calculate_fall_time(double H) {
    return sqrt(2 * H / g);
}

// Функция для метода секущих (демонстрационная - в данной задаче не требуется)
double secant_method(double (*f)(double), double x0, double x1, double tol, int max_iter) {
    double x2;
    for (int i = 0; i < max_iter; ++i) {
        if (fabs(f(x1)) < tol) return x1;
        if (fabs(x1 - x0) < tol) return x1;
        
        x2 = x1 - f(x1) * (x1 - x0) / (f(x1) - f(x0));
        x0 = x1;
        x1 = x2;
    }
    throw runtime_error("Метод секущих не сошелся");
}

int main() {
    try {
        double H, U;
        
        // Ввод данных
        cout << "Введите высоту полета H (м): ";
        cin >> H;
        cout << "Введите скорость самолета U (м/с): ";
        cin >> U;
        
        // Проверка входных данных
        if (H <= 0 || U <= 0) {
            throw invalid_argument("Высота и скорость должны быть положительными");
        }
        
        // Вычисление времени падения
        double T = calculate_fall_time(H);
        
        // Вычисление подлетного расстояния
        double S = U * T;
        
        // Вывод результатов
        cout << fixed << setprecision(2);
        cout << "\nРезультаты расчета:\n";
        cout << "Время падения бомбы T (с): " << T << endl;
        cout << "Подлетное расстояние S (м): " << S << endl;
        
    } catch (const exception& e) {
        cerr << "Ошибка: " << e.what() << endl;
        return 1;
    }
    
    return 0;
}
    
    
