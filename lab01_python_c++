1 задача на питоне/метод итерации
import math

def calculate_angle(V, T, epsilon=1e-6, max_iter=1000):
    """
    Вычисляет угол α методом итерации по формуле: α = arcsin(gT/(2V))
    
    Параметры:
        V (float): начальная скорость (м/с)
        T (float): время полета (с)
        epsilon (float): точность вычислений
        max_iter (int): максимальное число итераций
    
    Возвращает:
        float: угол α в радианах
    """
    g = 9.81
    target = g * T / (2 * V)
    
    # Проверка физической реализуемости
    if abs(target) > 1:
        raise ValueError("Невозможно достичь заданной дальности при данных параметрах")
    
    # Метод итерации: α = arcsin(target)
    alpha = 0.0  # Начальное приближение
    for _ in range(max_iter):
        new_alpha = math.asin(target)
        if abs(new_alpha - alpha) < epsilon:
            return new_alpha
        alpha = new_alpha
    
    raise ValueError("Метод не сошелся за указанное число итераций")

# Ввод данных
try:
    V = float(input("Введите начальную скорость V (м/с): "))
    T = float(input("Введите время полета T (с): "))
    
    # Вычисление угла
    alpha_rad = calculate_angle(V, T)
    alpha_deg = math.degrees(alpha_rad)
    
    # Вывод результата
    print(f"Угол α (радианы): {alpha_rad:.4f}")
    print(f"Угол α (градусы): {alpha_deg:.2f}°")

except ValueError as e:
    print(f"Ошибка: {str(e)}")

