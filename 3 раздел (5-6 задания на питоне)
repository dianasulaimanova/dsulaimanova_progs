import math

def sum_series1(x, precision=1e-6):
    sum = 0.0
    n = 1
    term = 0.0
    
    while abs(term) > precision and n < 1000000:
        term = (-1)**n / (math.sin(n * x) + 1 + n**2)
        sum += term
        n += 1
    
    return sum

def sum_series2(x, precision=1e-6):
    sum = 0.0
    n = 1
    term = 0.0
    
    while abs(term) > precision and n < 1000000:
        term = math.cos(n * x) / (math.exp(-n * x) + math.exp(n))
        sum += term
        n += 1
    
    return sum

x = float(input("Enter the value of x: "))

print(f"1) Sum of the series ∑(-1)^n/(sin(nx)+1+n²) = {sum_series1(x):.8f}")
print(f"2) Sum of the series ∑cos(nx)/(e^(-nx)+e^n) = {sum_series2(x):.8f}")
